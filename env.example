# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=postgresql://username:password@localhost:5432/eva_website_db

# ===========================================
# NEXT.JS CONFIGURATION
# ===========================================
NEXTAUTH_URL=https://evapremium.pl
NEXTAUTH_SECRET=your-nextauth-secret

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=development

# ===========================================
# API CONFIGURATION
# ===========================================
API_BASE_URL=https://evapremium.pl/api

# ===========================================
# POSTGRESQL CONFIGURATION (for scripts)
# ===========================================
PGHOST=localhost
PGPORT=5432
PGUSER=eva_user
PGPASSWORD=eva_password
PGDATABASE=eva_db

# ===========================================
# PRZELEWY24 CONFIGURATION
# ===========================================
# Globalne włączenie/wyłączenie integracji Przelewy24
P24_ENABLED=false

# SANDBOX (środowisko testowe)
# P24_MERCHANT_ID=YOUR_SANDBOX_P24_MERCHANT_ID
# P24_POS_ID=YOUR_SANDBOX_P24_POS_ID
# P24_CRC_KEY=YOUR_SANDBOX_P24_CRC_KEY
# P24_API_KEY=YOUR_SANDBOX_P24_API_KEY
# P24_REPORT_KEY=YOUR_SANDBOX_P24_REPORT_KEY


# Środowisko: "sandbox" dla testów, "production" dla rzeczywistych płatności
# UWAGA: Zmiana na "production" włącza rzeczywiste płatności!
P24_ENVIRONMENT=production

# URLe callback dla płatności (PRODUCTION)
P24_URL_RETURN=https://your-domain/payment/success
P24_URL_STATUS=https://your-domain/api/payments/p24/callback

# URLe callback dla development (np. ngrok) – uzupełnij własnymi
P24_URL_RETURN_LOCAL=http://localhost:3000/payment/success
P24_URL_STATUS_LOCAL=http://localhost:3000/api/payments/p24/callback

# Adresy API (automatyczne na podstawie środowiska)
P24_API_URL_SANDBOX=https://sandbox.przelewy24.pl/api/v1
P24_API_URL_PRODUCTION=https://secure.przelewy24.pl/api/v1

# ===========================================
# BITRIX24 CONFIGURATION
# ===========================================
# Webhook URL z Bitrix24 (zastąp xxxxx swoim kodem)
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.com/rest/1/xxxxx/
BITRIX24_WEBHOOK_ENABLED=true
BITRIX24_AUTO_SYNC_ORDERS=true
BITRIX24_AUTO_SYNC_LEADS=true

# Domyślne etapy/statusy w Bitrix24
BITRIX24_DEFAULT_DEAL_STAGE=NEW
BITRIX24_DEFAULT_LEAD_STATUS=NEW
BITRIX24_DEFAULT_LEAD_SOURCE=WEB